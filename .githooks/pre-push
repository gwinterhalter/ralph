#!/usr/bin/env bash
# CF_SECRET_SCAN_HOOK_V1  (idempotent marker - do not remove)
# stdin is captured ONCE and replayed to every consumer: a chained prior hook
# reading stdin would otherwise starve the scanner and leave it silently inert.
set -u
SCANNER='K:/CF-Backup/scripts/secret-scan/Invoke-SecretScan.ps1'
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PRIOR="$HOOK_DIR/pre-push.pre-secret-scan"
REPO_ROOT="$(git rev-parse --show-toplevel)"
PAYLOAD="$(cat)"
rc=0
if [ -f "$PRIOR" ]; then
  printf '%s\n' "$PAYLOAD" | bash "$PRIOR" "$@" || rc=$?
  if [ "$rc" -ne 0 ]; then echo "pre-push: chained prior hook FAILED rc=$rc" >&2; fi
fi
printf '%s\n' "$PAYLOAD" | powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCANNER" -Mode Push -RepoRoot "$REPO_ROOT"
src=$?
if [ "$src" -ne 0 ]; then rc=$src; fi
exit $rc
