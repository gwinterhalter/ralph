# Ralph working files (generated during runs)
prd.json
progress.txt
.last-branch

# Supervisor runtime state when state_dir defaults to the repo (operator command
# channel written by control_panel.write_command); runtime state, never tracked.
commands/
state/
# Learn-step runtime output (learning_corpus.jsonl, run_auditor_report.md) written
# when workspace_root defaults to the repo during a local --once run; never tracked.
logs/
# Supervisor/webui runtime files when state_dir defaults to the repo (operator action log +
# the loop pid file the GUI's supervisor control writes); never tracked.
operator_actions.jsonl
*.pid

# Archive is optional to commit
# archive/

# OS files
.DS_Store

# Python test artifacts (pytest scaffold under tests/; regenerated every cf-pytest run —
# must stay untracked so per-iteration clean-tree/commit discipline isn't tripped)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Control-panel GUI (webui/app) JS build + test artifacts — never tracked.
webui/app/node_modules/
webui/app/dist/
webui/app/test-results/
webui/app/playwright-report/
webui/app/.vite/
webui/app/.e2e-state/

#Claude
# Exclude .claude/ CONTENTS (not the dir itself — required for the negation below to
# reach inside; `.claude/` with trailing slash would block negations).
.claude/*
# FUP-0815: tracked-carve-out for operator-scribe slash-commands (\btw etc.)
# The .claude/commands/ subtree contains intentional, shareable scribe slash-commands
# (CC has zero discretion; orchestrator obeys operator intent transcribed by CC).
# All other .claude/ contents (session state, auth tokens, etc.) remain excluded.
!.claude/commands/
!.claude/commands/**

# Local editor/session backups (e.g. plan_review.sh.bak-20260701) — never tracked.
*.bak
*.bak-*
# webui build/server logs written when running the GUI locally — runtime, never tracked.
webui/**/*.log
webui/**/*.log.err

# Superseded/archived local docs & versions parked under ralph/OLD/ — never tracked.
/OLD/

# Sandbox / scratch working directories (FUP-1245) — never tracked. Test-harness
# temp roots (tests/test_fup_0815_*.sh, test_fup_0851_0852_*.sh) already live under
# the OS temp dir via mktemp -d and need no entry here; this covers any future
# in-repo sandbox/scratch dir under this convention.
/sandbox/
/scratch/
*_sandbox/
*_scratch/
.sandbox/
.scratch/
